{
  "name": "saved-searches",
  "private": true,
  "version": "0.0.0",
  "description": "Тестовое задание WestMotors: сохранённые поиски автомобилей",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
